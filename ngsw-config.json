{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.json",
          "/*.css",
          "/*.js"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    },
    {
      "name": "branding",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/branding/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "auth-only",
      "urls": [
        "/api/auth/**"
      ],
      "cacheConfig": {
        "strategy": "networkOnly",
        "maxSize": 5,
        "maxAge": "5m",
        "timeout": "3s"
      }
    },
    {
      "name": "api-freshness",
      "urls": [
        "/api/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "5s"
      }
    }
  ]
}
